        "df = df.drop(columns=['Car_id', 'Dealer_No ', 'Color', 'Phone', 'Customer Name'], errors='ignore')\n",
        "\n",
        "# Fix column name\n",
        "df = df.rename(columns={'Price ($)': 'Price'})\n",
